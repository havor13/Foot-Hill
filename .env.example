# Postgres connection string (Neon, Vercel Postgres / Prisma Postgres, Supabase, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/foothill?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Needed when running behind a proxy or on a custom domain. Vercel sets this for you.
AUTH_TRUST_HOST=true

# Email for verification codes. Leave RESEND_API_KEY empty in development and the
# code is printed in the server console instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="Foothill Commons <no-reply@your-domain.com>"
