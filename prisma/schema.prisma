generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ALUMNI
}

enum GroupKind {
  GROUP
  COURSE
}

enum IntroStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  isAdmin       Boolean   @default(false)
  emailVerified DateTime?
  major         String?
  hometown      String?
  mission       String?
  bio           String?
  gradYear      Int?
  createdAt     DateTime  @default(now())

  alumni         AlumniProfile?
  codes          VerificationCode[]
  memberships    Membership[]
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  rsvps          Rsvp[]
  events         Event[]              @relation("EventCreator")
  introsSent     IntroRequest[]       @relation("IntroFrom")
  introsReceived IntroRequest[]       @relation("IntroTo")
  convMembers    ConversationMember[]
  messages       Message[]
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AlumniProfile {
  id       String   @id @default(cuid())
  userId   String   @unique
  jobTitle String
  location String
  industry String
  openTo   String[]
  bio      String
  approved Boolean  @default(false)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  kind        GroupKind @default(GROUP)
  courseCode  String?
  term        String?
  createdAt   DateTime  @default(now())

  memberships  Membership[]
  posts        Post[]
  events       Event[]
  conversation Conversation?

  @@index([kind])
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  isAdmin  Boolean  @default(false)
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model Post {
  id        String    @id @default(cuid())
  body      String
  authorId  String
  groupId   String
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  likes     Like[]
  comments  Comment[]

  @@index([groupId, createdAt])
}

model Like {
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  location    String
  description String?
  startsAt    DateTime
  groupId     String?
  createdById String
  createdAt   DateTime @default(now())
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  rsvps       Rsvp[]

  @@index([startsAt])
}

model Rsvp {
  userId  String
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

model IntroRequest {
  id        String      @id @default(cuid())
  fromId    String
  toId      String
  note      String
  status    IntroStatus @default(PENDING)
  createdAt DateTime    @default(now())
  from      User        @relation("IntroFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User        @relation("IntroTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, status])
}

model Conversation {
  id        String               @id @default(cuid())
  name      String?
  isGroup   Boolean              @default(false)
  dmKey     String?              @unique
  groupId   String?              @unique
  createdAt DateTime             @default(now())
  group     Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
